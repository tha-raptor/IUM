<!DOCTYPE html>
<html lang="en">
<head>
    <title>{{title}}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

    <link rel="icon" type="image/png" href="img/icon.png">
    <link rel="stylesheet" href="css/style.css">
    <script src="js/logic.js"></script>
    <script src="/socket.io/socket.io.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
    <div class="container">
        <a class="navbar-brand" href="/">🎬 MovieApp</a>
        <div class="d-flex align-items-center ms-auto">
            <span class="text-white me-2 small">Chat as:</span>
            <input type="text" id="chat-username" class="form-control form-control-sm" style="width: 150px; background: #333; color: white; border: none;" placeholder="Username" value="Guest">
        </div>
    </div>
</nav>

<div class="hero-header">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3 text-white">Find your next favorite story.</h1>
        <p class="lead mb-4 text-white-50">Search for movies, check ratings, and chat live.</p>

        <div class="d-flex justify-content-center">
            <form id="search-form" class="d-flex w-100" style="max-width: 600px;">
                <input id="search-input" type="text" class="search-input" placeholder="Search for a movie (e.g. Inception)..." autocomplete="off">
                <button class="btn btn-primary rounded-pill ms-2 px-4 fw-bold" type="submit">Search</button>
            </form>
        </div>
    </div>
</div>

<div class="container pb-5">



    <div id="movie-results-section">
        <h4 class="mb-4 text-white border-start border-4 border-danger ps-3">Search Results</h4>
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4" id="movie-grid">
            <p class="text-muted">Start by searching for a movie above...</p>
        </div>
    </div>

    <div id="loading-spinner" class="text-center my-5 d-none">
        <div class="spinner-border text-danger" role="status" style="width: 3rem; height: 3rem;"></div>
    </div>

    <div id="main-content" class="mt-4"></div>

</div>

</body>
</html>