<!DOCTYPE html>
<html lang="">
<head>
    <title>{{title}}</title>
    <meta charset="utf-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/png" href="../img/icon.png">
    <link rel="stylesheet" href="../css/style.css">
    <script src="../js/logic.js"></script>
</head>
<body>
<div class="container text-center mt-5">
    <h1>Movie Discovery Engine</h1>
    <form id="search-form" class="d-flex mt-4" role="search">
        <div class="input-group mb-3">
            <label>
                <input id="search-input" type="text" name="q" class="form-control form-control-lg" placeholder="Search for a movie (e.g. Percy Jackson)...">
            </label>
            <button class="btn btn-primary" type="submit">Search</button>
        </div>
    </form>
    <div id="main-content" class="mt-5">
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    </div>
</div>
</body>
</html>